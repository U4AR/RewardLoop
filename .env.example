# Local example only. Copy to .env.local, generate unique secrets, and never commit that file.
APP_RUNTIME=hackathon
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://rewardloop:local_demo_only@localhost:5432/rewardloop
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATA_ENCRYPTION_KEY=
ALLOW_LOCAL_SIGNUP=true
ALLOW_FIXTURE_PROVIDERS=true
PAYMENT_PROVIDER=paypal_sandbox
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
PAYPAL_SANDBOX_MERCHANT_ID=
PAYPAL_SANDBOX_WEBHOOK_ID=
CHANNEL3_API_KEY=
KERNEL_API_KEY=
ANTHROPIC_API_KEY=
EVIDENCE_MODEL=
LOCAL_EVIDENCE_URL=
LOCAL_EVIDENCE_MODEL=
SHOPPING_MODEL=
# Local store host: separate from localhost app cookies. For Kernel, replace with a distinct reachable HTTPS store host.
MOCK_STORE_ORIGIN=http://127.0.0.1:3000
BUSINESS_CLOCK_MODE=real
MAX_BROWSER_CONCURRENCY=2
MAX_BROWSER_RUN_SECONDS=600
MAX_AGENT_TOOL_STEPS=25
MAX_LLM_COST_USD_PER_PURCHASE=1.00
